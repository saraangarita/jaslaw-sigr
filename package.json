{
  "name": "jaslaw-sigr",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Jaslaw · sistema de gestión de pedidos y reservas con pipeline CI/CD",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle.mjs",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "ci": "npm run lint && npm run test:coverage && npm run build && npm run check:bundle",
    "audit:full": "npm audit || true"
  },
  "dependencies": {
    "lucide-react": "^0.451.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^15.15.0",
    "jsdom": "^25.0.1",
    "vite": "^5.4.8",
    "vitest": "^3.2.7"
  }
}
